package __TARGET_PACKAGE__;

import android.media.MediaRecorder;
import android.net.Uri;
import android.opengl.EGL14;
import android.opengl.EGLExt;
import android.opengl.GLES20;
import android.util.Log;
import android.view.Surface;


import java.io.IOException;
import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.nio.FloatBuffer;
import java.util.ArrayDeque;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.AtomicReference;

/**
 * Records processed frames without making the encoder EGL context current on the preview thread.
 *
 * The preview thread copies each accepted frame into one of three shared 2D textures. A dedicated
 * EGL thread consumes those textures and submits them to MediaRecorder's input Surface. When all
 * slots are busy the newest preview frame is dropped instead of blocking EffectKit rendering.
 */
final class NveVideoRecorder implements NveFinalTextureFrameSink {
    interface EventListener {
        void onFirstFrameAccepted();
        void onStopRequested(String reason, boolean failure);
    }

    interface Completion {
        void onCompleted(Uri galleryUri);
        void onFailed(String reason);
    }

    private static final String TAG = "NveVideoRecorder";
    private static final int EGL_RECORDABLE_ANDROID = 0x3142;
    private static final int FRAME_RATE = 30;
    private static final int FRAME_SLOT_COUNT = 3;
    private static final int MAX_DURATION_MS = 30 * 60 * 1000;
    private static final long MAX_FILE_SIZE_BYTES = 1_800_000_000L;
    private static final ExecutorService FINALIZE_EXECUTOR =
            Executors.newSingleThreadExecutor(runnable -> {
                Thread thread = new Thread(runnable, "NveRecordingFinalize");
                thread.setDaemon(true);
                return thread;
            });

    private final RecordingOutputTarget outputTarget;
    private final int width;
    private final int height;
    private final boolean audioEnabled;
    private final EventListener eventListener;
    private final AtomicReference<String> fatalError = new AtomicReference<>();

    private MediaRecorder mediaRecorder;
    private Surface inputSurface;
    private EncoderRenderThread renderThread;
    private FrameSlot[] frameSlots;
    private boolean started;
    private boolean stopping;
    private volatile boolean gracefulStopRequested;

    NveVideoRecorder(
            RecordingOutputTarget outputTarget,
            int width,
            int height,
            boolean audioEnabled,
            EventListener eventListener) {
        this.outputTarget = outputTarget;
        this.width = width;
        this.height = height;
        this.audioEnabled = audioEnabled;
        this.eventListener = eventListener;
    }

    String displayName() {
        return outputTarget.displayName();
    }

    void startOnGlThread() throws IOException {
        android.opengl.EGLContext previewContext = EGL14.eglGetCurrentContext();
        android.opengl.EGLDisplay eglDisplay = EGL14.eglGetCurrentDisplay();
        if (previewContext == EGL14.EGL_NO_CONTEXT || eglDisplay == EGL14.EGL_NO_DISPLAY) {
            throw new IllegalStateException("Recording requires a current preview EGLContext");
        }

        try {
            initializeFrameSlots();
            mediaRecorder = createMediaRecorder();
            mediaRecorder.prepare();
            inputSurface = mediaRecorder.getSurface();
            renderThread = new EncoderRenderThread(
                    eglDisplay,
                    previewContext,
                    inputSurface,
                    width,
                    height,
                    eventListener::onFirstFrameAccepted);
            renderThread.startAndAwaitReady();
            mediaRecorder.start();
            renderThread.markRecorderStarted(System.nanoTime());
            started = true;
            Log.i(
                    TAG,
                    "Recording encoder started: "
                            + width
                            + "x"
                            + height
                            + ", audio="
                            + audioEnabled);
        } catch (IOException | RuntimeException error) {
            releaseRenderThread();
            releaseFrameSlots();
            releaseMediaRecorder(false);
            outputTarget.abort();
            throw error;
        }
    }

    @Override
    public void onFrame(
            NveFinalTextureFrameSink.Renderer presenter,
            int textureTarget,
            int textureId,
            float[] textureMatrix,
            int sourceWidth,
            int sourceHeight,
            long timestampNs) {
        if (!started || stopping) {
            return;
        }
        String failure = fatalError.get();
        if (failure != null) {
            throw new IllegalStateException(failure);
        }
        EncoderRenderThread activeThread = renderThread;
        RuntimeException renderFailure =
                activeThread == null ? null : activeThread.failure();
        if (renderFailure != null) {
            if (gracefulStopRequested) {
                return;
            }
            throw renderFailure;
        }
        FrameSlot slot = acquireFrameSlot();
        if (activeThread == null || slot == null) {
            return;
        }

        int[] previousFramebuffer = new int[1];
        int[] previousViewport = new int[4];
        GLES20.glGetIntegerv(
                GLES20.GL_FRAMEBUFFER_BINDING,
                previousFramebuffer,
                0);
        GLES20.glGetIntegerv(GLES20.GL_VIEWPORT, previousViewport, 0);
        boolean copied = false;
        try {
            GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, slot.framebufferId);
            GLES20.glViewport(0, 0, width, height);
            copied = presenter.drawToCurrentSurface(
                    textureTarget,
                    textureId,
                    textureMatrix,
                    sourceWidth,
                    sourceHeight,
                    width,
                    height);
            if (copied) {
                // The encoder consumes this texture from a shared context on another thread.
                GLES20.glFinish();
            }
        } finally {
            GLES20.glBindFramebuffer(
                    GLES20.GL_FRAMEBUFFER,
                    previousFramebuffer[0]);
            GLES20.glViewport(
                    previousViewport[0],
                    previousViewport[1],
                    previousViewport[2],
                    previousViewport[3]);
            presenter.restoreHostGlState();
        }

        if (!copied || !activeThread.offer(slot, timestampNs)) {
            slot.inUse = false;
            if (!copied) {
                throw new IllegalStateException("Unable to copy the processed recording frame");
            }
            renderFailure = activeThread.failure();
            if (renderFailure != null) {
                if (gracefulStopRequested) {
                    return;
                }
                throw renderFailure;
            }
            return;
        }
    }

    void stopOnGlThread(Completion completion) {
        finishOnGlThread(false, completion);
    }

    void abortOnGlThread(Completion completion) {
        finishOnGlThread(true, completion);
    }

    private void finishOnGlThread(boolean forceAbort, Completion completion) {
        if (stopping) {
            return;
        }
        stopping = true;
        started = false;
        EncoderRenderThread activeRenderThread = renderThread;
        renderThread = null;
        boolean rendererDrained =
                activeRenderThread == null || activeRenderThread.stopAndAwaitDrained();
        if (rendererDrained) {
            releaseFrameSlots();
        }

        MediaRecorder recorder = mediaRecorder;
        Surface recorderSurface = inputSurface;
        mediaRecorder = null;
        inputSurface = null;
        boolean hasVideo =
                activeRenderThread != null && activeRenderThread.submittedFrameCount() > 0;
        RuntimeException renderFailure =
                activeRenderThread == null ? null : activeRenderThread.failure();
        String knownFailure = fatalError.get();
        if (knownFailure == null && renderFailure != null && !gracefulStopRequested) {
            knownFailure = "录制画面编码失败";
        }
        String finalKnownFailure = knownFailure;
        Log.i(
                TAG,
                "Finalizing recording: abort="
                        + forceAbort
                        + ", drained="
                        + rendererDrained
                        + ", submittedFrames="
                        + (activeRenderThread == null
                                ? 0 : activeRenderThread.submittedFrameCount())
                        + ", failure="
                        + finalKnownFailure);
        FINALIZE_EXECUTOR.execute(() -> {
            boolean valid =
                    !forceAbort && rendererDrained && hasVideo && finalKnownFailure == null;
            String failureReason = finalKnownFailure;
            if (recorder != null) {
                if (valid) {
                    try {
                        recorder.stop();
                    } catch (RuntimeException error) {
                        valid = false;
                        failureReason = "无法完成视频录制";
                        Log.e(TAG, "MediaRecorder stop failed", error);
                    }
                }
                if (activeRenderThread != null
                        && !activeRenderThread.releaseAfterRecorderStopped()) {
                    valid = false;
                    if (failureReason == null) {
                        failureReason = "录制编码器释放超时";
                    }
                }
                try {
                    recorder.reset();
                } catch (RuntimeException ignored) {
                    // Release remains the authoritative cleanup.
                }
                recorder.release();
            }
            if (recorderSurface != null) {
                recorderSurface.release();
            }

            if (!valid) {
                outputTarget.abort();
                completion.onFailed(
                        failureReason == null ? "录制时间太短，未生成视频" : failureReason);
                return;
            }
            try {
                completion.onCompleted(outputTarget.finish());
            } catch (IOException | RuntimeException error) {
                outputTarget.abort();
                Log.e(TAG, "Unable to publish recording output", error);
                completion.onFailed("视频保存到手机相册失败");
            }
        });
    }

    private MediaRecorder createMediaRecorder() {
        MediaRecorder recorder = new MediaRecorder();
        if (audioEnabled) {
            recorder.setAudioSource(MediaRecorder.AudioSource.CAMCORDER);
        }
        recorder.setVideoSource(MediaRecorder.VideoSource.SURFACE);
        recorder.setOutputFormat(MediaRecorder.OutputFormat.MPEG_4);
        outputTarget.configure(recorder);
        recorder.setVideoEncoder(MediaRecorder.VideoEncoder.H264);
        recorder.setVideoEncodingBitRate(
                NveVideoRecordingConfig.compatibleBitRate(width, height));
        recorder.setVideoFrameRate(FRAME_RATE);
        recorder.setVideoSize(width, height);
        if (audioEnabled) {
            recorder.setAudioEncoder(MediaRecorder.AudioEncoder.AAC);
            recorder.setAudioChannels(1);
            recorder.setAudioSamplingRate(44_100);
            recorder.setAudioEncodingBitRate(96_000);
        }
        recorder.setMaxDuration(MAX_DURATION_MS);
        recorder.setMaxFileSize(MAX_FILE_SIZE_BYTES);
        recorder.setOnErrorListener((ignored, what, extra) -> {
            String reason = "录制编码器发生错误";
            fatalError.compareAndSet(null, reason);
            eventListener.onStopRequested(reason, true);
            Log.e(TAG, "MediaRecorder error: what=" + what + ", extra=" + extra);
        });
        recorder.setOnInfoListener((ignored, what, extra) -> {
            if (what == MediaRecorder.MEDIA_RECORDER_INFO_MAX_DURATION_REACHED
                    || what == MediaRecorder.MEDIA_RECORDER_INFO_MAX_FILESIZE_REACHED) {
                gracefulStopRequested = true;
                eventListener.onStopRequested("已达到录制上限，正在保存", false);
            }
        });
        return recorder;
    }

    private void initializeFrameSlots() {
        frameSlots = new FrameSlot[FRAME_SLOT_COUNT];
        int[] previousFramebuffer = new int[1];
        GLES20.glGetIntegerv(
                GLES20.GL_FRAMEBUFFER_BINDING,
                previousFramebuffer,
                0);
        for (int index = 0; index < FRAME_SLOT_COUNT; index++) {
            int[] texture = new int[1];
            int[] framebuffer = new int[1];
            GLES20.glGenTextures(1, texture, 0);
            GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, texture[0]);
            GLES20.glTexParameteri(
                    GLES20.GL_TEXTURE_2D,
                    GLES20.GL_TEXTURE_MIN_FILTER,
                    GLES20.GL_LINEAR);
            GLES20.glTexParameteri(
                    GLES20.GL_TEXTURE_2D,
                    GLES20.GL_TEXTURE_MAG_FILTER,
                    GLES20.GL_LINEAR);
            GLES20.glTexParameteri(
                    GLES20.GL_TEXTURE_2D,
                    GLES20.GL_TEXTURE_WRAP_S,
                    GLES20.GL_CLAMP_TO_EDGE);
            GLES20.glTexParameteri(
                    GLES20.GL_TEXTURE_2D,
                    GLES20.GL_TEXTURE_WRAP_T,
                    GLES20.GL_CLAMP_TO_EDGE);
            GLES20.glTexImage2D(
                    GLES20.GL_TEXTURE_2D,
                    0,
                    GLES20.GL_RGBA,
                    width,
                    height,
                    0,
                    GLES20.GL_RGBA,
                    GLES20.GL_UNSIGNED_BYTE,
                    null);
            GLES20.glGenFramebuffers(1, framebuffer, 0);
            GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, framebuffer[0]);
            GLES20.glFramebufferTexture2D(
                    GLES20.GL_FRAMEBUFFER,
                    GLES20.GL_COLOR_ATTACHMENT0,
                    GLES20.GL_TEXTURE_2D,
                    texture[0],
                    0);
            if (GLES20.glCheckFramebufferStatus(GLES20.GL_FRAMEBUFFER)
                    != GLES20.GL_FRAMEBUFFER_COMPLETE) {
                throw new IllegalStateException("Unable to create a recording frame buffer");
            }
            frameSlots[index] = new FrameSlot(texture[0], framebuffer[0]);
        }
        GLES20.glBindFramebuffer(
                GLES20.GL_FRAMEBUFFER,
                previousFramebuffer[0]);
        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, 0);
    }

    private FrameSlot acquireFrameSlot() {
        FrameSlot[] slots = frameSlots;
        if (slots == null) {
            return null;
        }
        for (FrameSlot slot : slots) {
            if (!slot.inUse) {
                slot.inUse = true;
                return slot;
            }
        }
        return null;
    }

    private void releaseFrameSlots() {
        FrameSlot[] slots = frameSlots;
        frameSlots = null;
        if (slots == null) {
            return;
        }
        int[] textures = new int[slots.length];
        int[] framebuffers = new int[slots.length];
        for (int index = 0; index < slots.length; index++) {
            textures[index] = slots[index].textureId;
            framebuffers[index] = slots[index].framebufferId;
        }
        GLES20.glDeleteFramebuffers(framebuffers.length, framebuffers, 0);
        GLES20.glDeleteTextures(textures.length, textures, 0);
    }

    private boolean releaseRenderThread() {
        EncoderRenderThread activeThread = renderThread;
        renderThread = null;
        return activeThread == null || activeThread.stopAndReleaseImmediately();
    }

    private void releaseMediaRecorder(boolean stop) {
        MediaRecorder recorder = mediaRecorder;
        mediaRecorder = null;
        if (recorder != null) {
            if (stop) {
                try {
                    recorder.stop();
                } catch (RuntimeException ignored) {
                    // The incomplete output is rolled back by the caller.
                }
            }
            recorder.release();
        }
        if (inputSurface != null) {
            inputSurface.release();
            inputSurface = null;
        }
    }

    private static android.opengl.EGLConfig chooseRecordableConfig(
            android.opengl.EGLDisplay display) {
        int[] attributes = {
                EGL14.EGL_RED_SIZE, 8,
                EGL14.EGL_GREEN_SIZE, 8,
                EGL14.EGL_BLUE_SIZE, 8,
                EGL14.EGL_ALPHA_SIZE, 8,
                EGL14.EGL_RENDERABLE_TYPE, EGL14.EGL_OPENGL_ES2_BIT,
                EGL_RECORDABLE_ANDROID, 1,
                EGL14.EGL_NONE
        };
        android.opengl.EGLConfig[] configs = new android.opengl.EGLConfig[1];
        int[] count = new int[1];
        if (!EGL14.eglChooseConfig(
                display,
                attributes,
                0,
                configs,
                0,
                configs.length,
                count,
                0)
                || count[0] == 0
                || configs[0] == null) {
            throw new IllegalStateException("No recordable EGLConfig is available");
        }
        return configs[0];
    }

    private static final class FrameSlot {
        final int textureId;
        final int framebufferId;
        volatile boolean inUse;

        FrameSlot(int textureId, int framebufferId) {
            this.textureId = textureId;
            this.framebufferId = framebufferId;
        }
    }

    private static final class QueuedFrame {
        final FrameSlot slot;
        final long timestampNs;

        QueuedFrame(FrameSlot slot, long timestampNs) {
            this.slot = slot;
            this.timestampNs = timestampNs;
        }
    }

    private static final class EncoderRenderThread extends Thread {
        private static final float[] QUAD = {
                -1f, -1f, 0f, 0f,
                 1f, -1f, 1f, 0f,
                -1f,  1f, 0f, 1f,
                 1f,  1f, 1f, 1f
        };
        private static final String VERTEX_SHADER =
                "attribute vec2 aPosition;\n"
                        + "attribute vec2 aTexCoord;\n"
                        + "varying vec2 vTexCoord;\n"
                        + "void main() {\n"
                        + "  gl_Position = vec4(aPosition, 0.0, 1.0);\n"
                        + "  vTexCoord = aTexCoord;\n"
                        + "}\n";
        private static final String FRAGMENT_SHADER =
                "precision mediump float;\n"
                        + "uniform sampler2D uTexture;\n"
                        + "varying vec2 vTexCoord;\n"
                        + "void main() { gl_FragColor = texture2D(uTexture, vTexCoord); }\n";

        private final Object lock = new Object();
        private final ArrayDeque<QueuedFrame> queue = new ArrayDeque<>();
        private final CountDownLatch ready = new CountDownLatch(1);
        private final CountDownLatch drained = new CountDownLatch(1);
        private final CountDownLatch released = new CountDownLatch(1);
        private final android.opengl.EGLDisplay eglDisplay;
        private final android.opengl.EGLContext sharedContext;
        private final Surface inputSurface;
        private final int width;
        private final int height;
        private final Runnable firstFrameSubmitted;
        private final AtomicReference<RuntimeException> failure = new AtomicReference<>();
        private final AtomicInteger submittedFrames = new AtomicInteger();
        private volatile boolean stopRequested;
        private volatile boolean releaseRequested;

        private android.opengl.EGLContext encoderContext = EGL14.EGL_NO_CONTEXT;
        private android.opengl.EGLSurface encoderSurface = EGL14.EGL_NO_SURFACE;
        private int program;
        private FloatBuffer quad;
        private volatile long recordingStartTimestampNs;
        private long firstSourceTimestampNs;
        private long lastTimestampNs;

        EncoderRenderThread(
                android.opengl.EGLDisplay eglDisplay,
                android.opengl.EGLContext sharedContext,
                Surface inputSurface,
                int width,
                int height,
                Runnable firstFrameSubmitted) {
            super("NveRecordingEgl");
            this.eglDisplay = eglDisplay;
            this.sharedContext = sharedContext;
            this.inputSurface = inputSurface;
            this.width = width;
            this.height = height;
            this.firstFrameSubmitted = firstFrameSubmitted;
            setDaemon(true);
        }

        void startAndAwaitReady() {
            start();
            try {
                if (!ready.await(2, TimeUnit.SECONDS)) {
                    throw new IllegalStateException("Timed out creating the recording EGL context");
                }
            } catch (InterruptedException error) {
                Thread.currentThread().interrupt();
                throw new IllegalStateException("Recording EGL setup was interrupted", error);
            }
            RuntimeException setupFailure = failure.get();
            if (setupFailure != null) {
                throw setupFailure;
            }
        }

        boolean offer(FrameSlot slot, long timestampNs) {
            synchronized (lock) {
                if (stopRequested || failure.get() != null) {
                    return false;
                }
                queue.addLast(new QueuedFrame(slot, timestampNs));
                lock.notifyAll();
                return true;
            }
        }

        RuntimeException failure() {
            return failure.get();
        }

        boolean stopAndAwaitDrained() {
            synchronized (lock) {
                stopRequested = true;
                lock.notifyAll();
            }
            try {
                return drained.await(2, TimeUnit.SECONDS);
            } catch (InterruptedException error) {
                Thread.currentThread().interrupt();
                return false;
            }
        }

        boolean releaseAfterRecorderStopped() {
            synchronized (lock) {
                releaseRequested = true;
                lock.notifyAll();
            }
            try {
                return released.await(2, TimeUnit.SECONDS);
            } catch (InterruptedException error) {
                Thread.currentThread().interrupt();
                return false;
            }
        }

        boolean stopAndReleaseImmediately() {
            synchronized (lock) {
                stopRequested = true;
                releaseRequested = true;
                lock.notifyAll();
            }
            try {
                return released.await(2, TimeUnit.SECONDS);
            } catch (InterruptedException error) {
                Thread.currentThread().interrupt();
                return false;
            }
        }

        int submittedFrameCount() {
            return submittedFrames.get();
        }

        void markRecorderStarted(long timestampNs) {
            recordingStartTimestampNs = timestampNs;
        }

        @Override
        public void run() {
            try {
                initializeEgl();
            } catch (RuntimeException error) {
                failure.set(error);
            } finally {
                ready.countDown();
            }

            if (failure.get() == null) {
                renderLoop();
            } else {
                drained.countDown();
            }
            releaseQueuedFrames();
            releaseEgl();
            released.countDown();
        }

        private void renderLoop() {
            while (true) {
                QueuedFrame frame;
                synchronized (lock) {
                    while (queue.isEmpty() && !stopRequested) {
                        try {
                            lock.wait();
                        } catch (InterruptedException error) {
                            Thread.currentThread().interrupt();
                            stopRequested = true;
                            break;
                        }
                    }
                    if (queue.isEmpty() && stopRequested) {
                        break;
                    }
                    frame = queue.removeFirst();
                }
                try {
                    draw(frame);
                } catch (RuntimeException error) {
                    failure.compareAndSet(null, error);
                    stopRequested = true;
                } finally {
                    frame.slot.inUse = false;
                }
                if (failure.get() != null) {
                    break;
                }
            }
            releaseQueuedFrames();
            drained.countDown();
            synchronized (lock) {
                while (!releaseRequested) {
                    try {
                        lock.wait();
                    } catch (InterruptedException error) {
                        Thread.currentThread().interrupt();
                        releaseRequested = true;
                    }
                }
            }
        }

        private void draw(QueuedFrame frame) {
            GLES20.glBindFramebuffer(GLES20.GL_FRAMEBUFFER, 0);
            GLES20.glViewport(0, 0, width, height);
            GLES20.glDisable(GLES20.GL_BLEND);
            GLES20.glDisable(GLES20.GL_SCISSOR_TEST);
            GLES20.glDisable(GLES20.GL_DEPTH_TEST);
            GLES20.glDisable(GLES20.GL_CULL_FACE);
            GLES20.glUseProgram(program);
            int position = GLES20.glGetAttribLocation(program, "aPosition");
            int texCoord = GLES20.glGetAttribLocation(program, "aTexCoord");
            int sampler = GLES20.glGetUniformLocation(program, "uTexture");
            quad.position(0);
            GLES20.glEnableVertexAttribArray(position);
            GLES20.glVertexAttribPointer(
                    position,
                    2,
                    GLES20.GL_FLOAT,
                    false,
                    16,
                    quad);
            quad.position(2);
            GLES20.glEnableVertexAttribArray(texCoord);
            GLES20.glVertexAttribPointer(
                    texCoord,
                    2,
                    GLES20.GL_FLOAT,
                    false,
                    16,
                    quad);
            GLES20.glActiveTexture(GLES20.GL_TEXTURE0);
            GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, frame.slot.textureId);
            GLES20.glUniform1i(sampler, 0);
            GLES20.glDrawArrays(GLES20.GL_TRIANGLE_STRIP, 0, 4);
            GLES20.glDisableVertexAttribArray(position);
            GLES20.glDisableVertexAttribArray(texCoord);
            GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, 0);

            long sourceTimestamp =
                    frame.timestampNs > 0L ? frame.timestampNs : System.nanoTime();
            if (firstSourceTimestampNs == 0L) {
                firstSourceTimestampNs = sourceTimestamp;
            }
            long baseTimestamp = recordingStartTimestampNs > 0L
                    ? recordingStartTimestampNs : System.nanoTime();
            long sourceDelta = Math.max(0L, sourceTimestamp - firstSourceTimestampNs);
            long rebasedTimestamp = baseTimestamp + sourceDelta;
            long presentationTimestamp = rebasedTimestamp > lastTimestampNs
                    ? rebasedTimestamp : lastTimestampNs + 1L;
            lastTimestampNs = presentationTimestamp;
            EGLExt.eglPresentationTimeANDROID(
                    eglDisplay,
                    encoderSurface,
                    presentationTimestamp);
            if (!EGL14.eglSwapBuffers(eglDisplay, encoderSurface)) {
                throw new IllegalStateException("Unable to submit the recording frame");
            }
            if (submittedFrames.incrementAndGet() == 1) {
                Log.i(TAG, "First recording frame submitted");
                firstFrameSubmitted.run();
            }
        }

        private void initializeEgl() {
            android.opengl.EGLConfig config = chooseRecordableConfig(eglDisplay);
            int[] contextAttributes = {
                    EGL14.EGL_CONTEXT_CLIENT_VERSION, 2,
                    EGL14.EGL_NONE
            };
            encoderContext = EGL14.eglCreateContext(
                    eglDisplay,
                    config,
                    sharedContext,
                    contextAttributes,
                    0);
            if (encoderContext == null || encoderContext == EGL14.EGL_NO_CONTEXT) {
                throw new IllegalStateException("Unable to create the recording EGLContext");
            }
            int[] surfaceAttributes = {EGL14.EGL_NONE};
            encoderSurface = EGL14.eglCreateWindowSurface(
                    eglDisplay,
                    config,
                    inputSurface,
                    surfaceAttributes,
                    0);
            if (encoderSurface == null || encoderSurface == EGL14.EGL_NO_SURFACE) {
                throw new IllegalStateException("Unable to create the recording EGLSurface");
            }
            if (!EGL14.eglMakeCurrent(
                    eglDisplay,
                    encoderSurface,
                    encoderSurface,
                    encoderContext)) {
                throw new IllegalStateException("Unable to bind the recording EGLSurface");
            }
            quad = ByteBuffer.allocateDirect(QUAD.length * 4)
                    .order(ByteOrder.nativeOrder())
                    .asFloatBuffer();
            quad.put(QUAD).position(0);
            program = createProgram(VERTEX_SHADER, FRAGMENT_SHADER);
        }

        private void releaseQueuedFrames() {
            synchronized (lock) {
                while (!queue.isEmpty()) {
                    queue.removeFirst().slot.inUse = false;
                }
            }
        }

        private void releaseEgl() {
            if (eglDisplay == EGL14.EGL_NO_DISPLAY) {
                return;
            }
            if (program != 0 && encoderContext != EGL14.EGL_NO_CONTEXT) {
                GLES20.glDeleteProgram(program);
                program = 0;
            }
            EGL14.eglMakeCurrent(
                    eglDisplay,
                    EGL14.EGL_NO_SURFACE,
                    EGL14.EGL_NO_SURFACE,
                    EGL14.EGL_NO_CONTEXT);
            if (encoderSurface != EGL14.EGL_NO_SURFACE) {
                EGL14.eglDestroySurface(eglDisplay, encoderSurface);
                encoderSurface = EGL14.EGL_NO_SURFACE;
            }
            if (encoderContext != EGL14.EGL_NO_CONTEXT) {
                EGL14.eglDestroyContext(eglDisplay, encoderContext);
                encoderContext = EGL14.EGL_NO_CONTEXT;
            }
            EGL14.eglReleaseThread();
        }

        private static int createProgram(String vertexSource, String fragmentSource) {
            int vertex = compileShader(GLES20.GL_VERTEX_SHADER, vertexSource);
            int fragment = compileShader(GLES20.GL_FRAGMENT_SHADER, fragmentSource);
            int result = GLES20.glCreateProgram();
            GLES20.glAttachShader(result, vertex);
            GLES20.glAttachShader(result, fragment);
            GLES20.glLinkProgram(result);
            int[] status = new int[1];
            GLES20.glGetProgramiv(result, GLES20.GL_LINK_STATUS, status, 0);
            GLES20.glDeleteShader(vertex);
            GLES20.glDeleteShader(fragment);
            if (status[0] == 0) {
                String log = GLES20.glGetProgramInfoLog(result);
                GLES20.glDeleteProgram(result);
                throw new IllegalStateException("Unable to link recording shader: " + log);
            }
            return result;
        }

        private static int compileShader(int type, String source) {
            int shader = GLES20.glCreateShader(type);
            GLES20.glShaderSource(shader, source);
            GLES20.glCompileShader(shader);
            int[] status = new int[1];
            GLES20.glGetShaderiv(shader, GLES20.GL_COMPILE_STATUS, status, 0);
            if (status[0] == 0) {
                String log = GLES20.glGetShaderInfoLog(shader);
                GLES20.glDeleteShader(shader);
                throw new IllegalStateException("Unable to compile recording shader: " + log);
            }
            return shader;
        }
    }
}

