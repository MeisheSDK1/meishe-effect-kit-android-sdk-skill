package __TARGET_PACKAGE__;

import android.media.Image;

import java.nio.ByteBuffer;

/**
 * Pure YUV_420_888 Image-to-NV21 conversion.
 *
 * The caller owns the Image and output buffer. Conversion runs before the Image is closed and
 * writes into a reusable output buffer, avoiding per-plane intermediate arrays.
 */
final class NveNv21Converter {
    private NveNv21Converter() {
    }

    static int requiredBufferSize(int width, int height) {
        if (width <= 0 || height <= 0 || (width & 1) != 0 || (height & 1) != 0) {
            return 0;
        }
        return width * height * 3 / 2;
    }

    static boolean convert(Image image, byte[] output) {
        if (image == null) {
            return false;
        }
        int width = image.getWidth();
        int height = image.getHeight();
        int requiredSize = requiredBufferSize(width, height);
        Image.Plane[] planes = image.getPlanes();
        if (requiredSize == 0 || output == null || output.length != requiredSize
                || planes == null || planes.length < 3) {
            return false;
        }

        Image.Plane y = planes[0];
        Image.Plane u = planes[1];
        Image.Plane v = planes[2];
        if (!valid(y) || !valid(u) || !valid(v)) {
            return false;
        }

        ByteBuffer yBuffer = y.getBuffer();
        ByteBuffer uBuffer = u.getBuffer();
        ByteBuffer vBuffer = v.getBuffer();
        int yBase = yBuffer.position();
        int uBase = uBuffer.position();
        int vBase = vBuffer.position();
        int offset = 0;

        if (y.getPixelStride() == 1) {
            for (int row = 0; row < height; row++) {
                int rowStart = yBase + row * y.getRowStride();
                if (rowStart < 0 || rowStart + width > yBuffer.limit()) {
                    return false;
                }
                yBuffer.position(rowStart);
                yBuffer.get(output, offset, width);
                offset += width;
            }
        } else {
            for (int row = 0; row < height; row++) {
                int rowStart = yBase + row * y.getRowStride();
                for (int col = 0; col < width; col++) {
                    int index = rowStart + col * y.getPixelStride();
                    if (index < 0 || index >= yBuffer.limit()) {
                        return false;
                    }
                    output[offset++] = yBuffer.get(index);
                }
            }
        }

        if (u.getPixelStride() == 2
                && v.getPixelStride() == 2
                && u.getRowStride() == v.getRowStride()
                && v.getRowStride() >= width
                && isInterleavedVu(uBuffer, vBuffer, uBase, vBase, width)) {
            // Camera2 commonly exposes NV21-backed chroma as overlapping U and V views.
            // Verify the overlap before copying VU rows in bulk; otherwise use the generic path.
            for (int row = 0; row < height / 2; row++) {
                int uRow = uBase + row * u.getRowStride();
                int vRow = vBase + row * v.getRowStride();
                int available = vBuffer.limit() - vRow;
                int copyLength = Math.min(width, available);
                if (vRow < 0 || copyLength < width - 1) {
                    return false;
                }
                vBuffer.position(vRow);
                vBuffer.get(output, offset, copyLength);
                if (copyLength < width) {
                    int finalU = uRow + width - 2;
                    if (finalU < 0 || finalU >= uBuffer.limit()) {
                        return false;
                    }
                    output[offset + width - 1] = uBuffer.get(finalU);
                }
                offset += width;
            }
        } else {
            for (int row = 0; row < height / 2; row++) {
                int uRow = uBase + row * u.getRowStride();
                int vRow = vBase + row * v.getRowStride();
                for (int col = 0; col < width / 2; col++) {
                    int uIndex = uRow + col * u.getPixelStride();
                    int vIndex = vRow + col * v.getPixelStride();
                    if (uIndex < 0 || uIndex >= uBuffer.limit()
                            || vIndex < 0 || vIndex >= vBuffer.limit()) {
                        return false;
                    }
                    output[offset++] = vBuffer.get(vIndex);
                    output[offset++] = uBuffer.get(uIndex);
                }
            }
        }
        return offset == requiredSize;
    }

    private static boolean valid(Image.Plane plane) {
        return plane != null && plane.getBuffer() != null
                && plane.getRowStride() > 0 && plane.getPixelStride() > 0;
    }

    private static boolean isInterleavedVu(
            ByteBuffer uBuffer,
            ByteBuffer vBuffer,
            int uBase,
            int vBase,
            int width) {
        int samples = Math.min(width / 2, 8);
        for (int col = 0; col < samples; col++) {
            int uIndex = uBase + col * 2;
            int vInterleavedU = vBase + col * 2 + 1;
            if (uIndex < 0 || uIndex >= uBuffer.limit()
                    || vInterleavedU < 0 || vInterleavedU >= vBuffer.limit()
                    || uBuffer.get(uIndex) != vBuffer.get(vInterleavedU)) {
                return false;
            }
        }
        return samples > 0;
    }
}
